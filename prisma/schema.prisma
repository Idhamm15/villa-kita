// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enum
enum ProductItemType {
  FACILITY
  INCLUDE
  EXCLUDE
}
enum Role {
  ADMIN
  OWNER
  USER
}
enum TypeProperty {
  Hotel
  Villa
  Apartment
  Guest
  Trip
}
enum TypeBooking {
  Menginap
  Harian
}
enum BookingStatus {
  PENDING
  PAID
  CANCELLED
  COMPLETED
}
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REFUND
}
enum VisitorType {
  SELF
  SOMEONE_ELSE
}

model UserToken {
  id           String   @id @default(cuid())

  userId       String
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshToken String   @unique
  expiredAt    DateTime

  createdAt    DateTime @default(now())

  @@index([userId])
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  fullname  String
  email     String   @unique
  password  String

  role       Role    @default(USER)

  phone      String?
  nameBank   String?
  noBank    String?
  avatar     String?
  address    String?
  isActive   Boolean @default(true)

  tokens      UserToken[]
  bookings    Booking[]

  ownedProducts   Product[] @relation("ProductOwner")
  createdProducts Product[] @relation("ProductCreator")

  registerAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CategoryProduct {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?

  products    Product[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())

  categoryId  String
  category    CategoryProduct @relation(fields: [categoryId], references: [id])

  name        String
  thumbnail   String
  typeProperty     TypeProperty[]
  location    String?
  address     String
  urlMaps     String
  typeBooking      TypeBooking[]

  serviceFee BigInt @default(5000)

  ownerId String
  owner User @relation("ProductOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  createdBy String
  user User @relation("ProductCreator", fields: [createdBy], references: [id])

  totalBedroom     Int
  totalBathroom     Int
  maxGuest     Int
  wide     Int

  priceStart  BigInt
  price       BigInt
  slug        String   @unique
  description String   @db.Text

  typeUnit    String

  stock       Int      @default(1)
  capacity    Int      @default(1)

  isActive    Boolean  @default(true)
  
  images       ProductImage[]
  items        ProductItem[]
  bookings     Booking[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@index([ownerId])
  @@index([createdBy])
}

model ProductItem {
  id         String @id @default(cuid())

  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  type       ProductItemType
  name       String
  sort       Int @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
  @@index([type])
}

model ProductImage {
  id        String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  image     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
  
}

model Booking {
  id String @id @default(cuid())
  transactionId String? @unique
  orderId String? @unique

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  nameGuest String
  email String
  phone String

  productId String
  product Product @relation(fields: [productId], references: [id])

  checkIn DateTime
  checkOut DateTime

  totalGuest Int

  bookingCode String @unique

  discount BigInt?
  totalPrice BigInt

  status BookingStatus @default(PENDING)
  visitorType VisitorType @default(SELF)

  paymentMethod String?
  paymentStatus PaymentStatus @default(PENDING)

  paymentToken String?      // Snap Token
  paymentUrl String?        // Snap Redirect URL

  paidAt DateTime?
  expiredAt DateTime?

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([productId])
  @@index([status])
  @@index([paymentStatus])
  @@index([orderId])
}

model Blog {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  thumbnail   String?
  content     String   @db.Text
  isPublished Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Voucher {
  id            String   @id @default(cuid())

  code          String   @unique
  description   String?

  discount      BigInt
  minPurchase   BigInt

  dateExpired   DateTime

  status        Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Partner {
  id        String   @id @default(cuid())

  name      String?
  image     String?
  sort      Int      @default(0)

  status    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}